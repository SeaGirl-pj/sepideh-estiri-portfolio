# Copy to .env.local for local development. Never commit real secrets.

# ── Admin (/admin/messages) ──────────────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Long random string (16+ characters) used to sign the HttpOnly session cookie
ADMIN_SESSION_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
# LOCAL: leave DATABASE_URL empty → SQLite at ./data/contact.db
# PRODUCTION (Vercel): set to your Neon/Postgres connection string
DATABASE_URL=

# Optional SQLite path override (local only)
CONTACT_DB_PATH=

# ── Email (Nodemailer / Gmail App Password) ──────────────────────────────────
# Gmail tip: use SMTP_PORT=465 if 587 is blocked on your network
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_RECEIVER_EMAIL=
