# Contact / admin / email — fill in locally. Never commit real secrets.
# Copy to .env.local for development.

# SQLite database path (optional; defaults to ./data/contact.db)
CONTACT_DB_PATH=

# Admin login for /admin/messages
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Use a long random string (16+ characters)
ADMIN_SESSION_SECRET=

# SMTP email notification (optional — messages are still saved if unset)
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-gmail@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password   (NOT your normal Gmail password)
#   SMTP_FROM=your-gmail@gmail.com
#   CONTACT_RECEIVER_EMAIL=your-gmail@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_RECEIVER_EMAIL=
